--- !u!114 &8118128062622521697
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1396079727911971689}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1f88e319e32af4b45ab8b9d0d32b69dd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pageName: 19
  openFade: {x: 1, y: 1, z: 0}
  closeFade: {x: 1, y: 1, z: 0}
  _group: {fileID: 2031202906423155097}
  _continue: {fileID: 1510506492506760275}
  _tutorialText: {fileID: 3974762767108294880}
  _textContents:
  - "\u041F\u043E\u0440\u0430\u0437\u0438\u0442\u044C \u0432\u0441\u0435 \u043C\u0438\u0448\u0435\u043D\u0438
    \u043D\u0430 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u043E\u0439
    \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0435.\n\n\n\n\n\n\n\u041F\u043E\u0441\u043B\u0435
    \u0443\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F \u0432 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u043C
    \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u0435
    \u043D\u0430\u0435\u043C\u043D\u0438\u043A (\u041A\u043B\u0438\u0447\u043A\u0430)
    \u0440\u0435\u0448\u0430\u0435\u0442 \u043E\u0441\u0432\u0435\u0436\u0438\u0442\u044C
    \u0441\u0432\u043E\u0438 \u043D\u0430\u0432\u044B\u043A\u0438. \u0412\u0434\u0430\u043B\u0438
    \u043E\u0442 \u043B\u044E\u0434\u0441\u043A\u0438\u0445 \u0433\u043B\u0430\u0437
    \u043E\u043D \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0441\u0442\u0430\u0440\u044B\u0439 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u044B\u0439
    \u043F\u043E\u043B\u0438\u0433\u043E\u043D \u0432\u0440\u0435\u043C\u0435\u043D
    \u0441\u043B\u0443\u0436\u0431\u044B, \u0447\u0442\u043E\u0431\u044B \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C
    \u043E\u0441\u043D\u043E\u0432\u044B \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B
    \u0438 \u043E\u0442\u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u0430\u0442\u044C
    \u043D\u043E\u0432\u043E\u0435 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435."
  - "\u0423\u0441\u0442\u0440\u0430\u043D\u0438\u0442\u044C \u0446\u0435\u043B\u044C
    \u2014 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u043E\u0433\u043E
    \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430..\n\n\n\n\n\n\n\u041F\u043E\u0441\u043B\u0435
    \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u043E\u0433\u043E
    \u043F\u043E\u043B\u0438\u0433\u043E\u043D\u0430 (\u041A\u043B\u0438\u0447\u043A\u0430)
    \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0441\u0432\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439
    \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442.
    \u041C\u0435\u0441\u0442\u043D\u044B\u0439 \u0431\u0438\u0437\u043D\u0435\u0441\u043C\u0435\u043D
    \u0445\u043E\u0447\u0435\u0442 \u0438\u0437\u0431\u0430\u0432\u0438\u0442\u044C\u0441\u044F
    \u043E\u0442 \u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0430
    \u2014 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u043E\u0433\u043E
    \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430, \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u0432\u0448\u0435\u0433\u043E\u0441\u044F
    \u0438\u0437 \u0432\u043E\u0435\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u043D\u043E\u0439 \u0444\u0438\u0440\u043C\u044B \u0432
    \u043A\u0440\u0438\u043C\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0435 \u043A\u0440\u0443\u0433\u0438."
  - "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432\n\n\n\n\n\n\n\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438
    \u043C\u043E\u0433\u0443\u0442 \u043E\u0431\u044A\u044F\u0432\u0438\u0442\u044C
    \u0442\u0440\u0435\u0432\u043E\u0433\u0443"
  - "\u0423\u0431\u0438\u0442\u044C \u043E\u0441\u043E\u0431\u043E \u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E
    \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u0438\u043A\u0430"
  - "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432"
  - "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432\n\n\n\n\n\n\n\u0431\u043E\u0447\u043A\u0438
    \u0441 \u0433\u043E\u0440\u044E\u0447\u0438\u043C  \u0432\u0437\u0440\u044B\u0432\u0430\u0442\u044C\u0441\u044F"
  - "\u0412\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435\n\n\n\n\n\n\n\u0435\u0441\u043B\u0438
    \u0437\u043E\u043C\u0431\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
    \u043C\u0438\u0441\u0441\u0438\u044F \u043F\u0440\u043E\u0432\u0430\u043B\u0435\u043D\u0430\n\u043E\u0431\u0437\u043E\u0440
    \u0438\u0433\u0440\u043E\u043A\u0430  360"
  - "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432"
  - "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432\n\n\n\n\n\n\n\u0412\u0435\u0442\u0435\u0440
    \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430 \u0441\u043D\u0430\u0440\u044F\u0434"
  - "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432"
  - "\u0412\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435\n\n\n\n\n\n\n\u043E\u0431\u0437\u043E\u0440
    \u0438\u0433\u0440\u043E\u043A\u0430  360"
  - "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432"
  - "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432"
  - "\u0412\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435\n\n\n\n\n\n\n\u043E\u0431\u0437\u043E\u0440
    \u0438\u0433\u0440\u043E\u043A\u0430  360"
  - "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432"
  - "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432"
  - "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432"
  - "\u0423\u0431\u0435\u0439 \u0432\u0441\u0435\u0445 \u0420\u0410\u0417\u0420\u0410\u0411\u041E\u0422\u0427\u0418\u041A\u041E\u0412"
