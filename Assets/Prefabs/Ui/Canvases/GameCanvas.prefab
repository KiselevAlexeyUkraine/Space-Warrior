  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041F\u043E\u0440\u0430\u0437\u0438\u0442\u044C \u0432\u0441\u0435 \u043C\u0438\u0448\u0435\u043D\u0438
    \u043D\u0430 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u043E\u0439
    \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0435.\n\n\n\n\n\n\n\u041F\u043E\u0441\u043B\u0435
    \u0443\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F \u0432 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u043C
    \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u0435
    \u043D\u0430\u0435\u043C\u043D\u0438\u043A (\u041A\u043B\u0438\u0447\u043A\u0430)
    \u0440\u0435\u0448\u0430\u0435\u0442 \u043E\u0441\u0432\u0435\u0436\u0438\u0442\u044C
    \u0441\u0432\u043E\u0438 \u043D\u0430\u0432\u044B\u043A\u0438. \u0412\u0434\u0430\u043B\u0438
    \u043E\u0442 \u043B\u044E\u0434\u0441\u043A\u0438\u0445 \u0433\u043B\u0430\u0437
    \u043E\u043D \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043D\u0430 \u0441\u0442\u0430\u0440\u044B\u0439 \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043E\u0447\u043D\u044B\u0439
    \u043F\u043E\u043B\u0438\u0433\u043E\u043D \u0432\u0440\u0435\u043C\u0435\u043D
    \u0441\u043B\u0443\u0436\u0431\u044B, \u0447\u0442\u043E\u0431\u044B \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C
    \u043E\u0441\u043D\u043E\u0432\u044B \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u044B
    \u0438 \u043E\u0442\u043A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u0430\u0442\u044C
    \u043D\u043E\u0432\u043E\u0435 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435."
